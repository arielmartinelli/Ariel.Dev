# Copiar a .env y completar. El archivo .env NUNCA se sube a Git.
#
# ============================================================================
#  LEER ESTO ANTES DE TOCAR NADA
# ============================================================================
#
#  Hay DOS grupos de variables y confundirlos es la forma más rápida de
#  filtrar un secreto:
#
#  GRUPO 1 — VITE_*  ->  PÚBLICAS. Quedan INCRUSTADAS en el bundle que baja
#                        cualquier visitante. Se leen con Ctrl+U. Esto es
#                        normal y esperado para la clave anon de Supabase: es
#                        pública por diseño. Lo que protege los datos NO es
#                        esconderla, son las políticas RLS de la base.
#
#  GRUPO 2 — sin VITE_ -> SECRETAS. Solo las ve el servidor (las funciones de
#                        /api en Vercel). Nunca viajan al navegador.
#
#  REGLA: si una variable permite hacer algo en tu nombre (cobrar, escribir en
#  la base ignorando RLS), NUNCA le pongas el prefijo VITE_.
#
# ============================================================================


# ----------------------------------------------------------------------------
#  GRUPO 1 — PÚBLICAS (van al navegador)
# ----------------------------------------------------------------------------

VITE_SUPABASE_URL=https://tu-proyecto-id.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_publica

# Formulario de contacto (Formspree). Solo el ID, no la URL completa:
# si tu endpoint es https://formspree.io/f/xdkogqzw -> VITE_FORMSPREE_ID=xdkogqzw
# Si se deja vacío, el formulario deriva a WhatsApp automáticamente.
VITE_FORMSPREE_ID=


# ----------------------------------------------------------------------------
#  GRUPO 2 — SECRETAS (solo servidor, /api)
#
#  En Vercel se cargan en: Settings -> Environment Variables.
#  NO llevan prefijo VITE_. Si se lo ponés, se publican.
# ----------------------------------------------------------------------------

# Misma URL que arriba, sin el prefijo, para las funciones serverless.
SUPABASE_URL=https://tu-proyecto-id.supabase.co

# service_role de Supabase: IGNORA TODAS LAS POLÍTICAS RLS.
# Con esta clave se puede leer, modificar y borrar cualquier fila de cualquier
# tabla. Es la llave maestra de la base de datos.
#   - Nunca en el navegador, nunca en el repo, nunca en un mensaje.
#   - Si se filtra, rotarla YA desde Supabase -> Settings -> API.
# Se usa solo en /api para verificar pagos, donde el navegador no llega.
SUPABASE_SERVICE_ROLE=

# Access token de producción de Mercado Pago (empieza con APP_USR-).
# Permite crear cobros y consultar pagos en tu nombre.
# Se saca de: mercadopago.com.ar/developers -> Tus integraciones -> Credenciales
# Para probar sin mover plata real, usar las credenciales de PRUEBA.
MP_ACCESS_TOKEN=

# Clave secreta del webhook de Mercado Pago.
# Se genera al configurar el webhook en: Tus integraciones -> Webhooks.
# Sin esto, /api/mp-webhook rechaza TODAS las notificaciones — a propósito:
# un webhook de pagos sin validar es un endpoint que regala trabajo gratis.
MP_WEBHOOK_SECRET=

# URL pública del sitio, sin barra final. Se usa para armar las URLs de
# retorno de Mercado Pago y la del webhook.
# Si se deja vacía se deduce del host de la petición.
SITE_URL=https://arieldev.com

# Cotización USD -> ARS de respaldo, por si dolarapi.com no responde.
# Mercado Pago cobra en pesos: sin un valor razonable acá, un fallo de la API
# haría cobrar un monto equivocado. Revisarlo cada tanto.
USD_ARS_FALLBACK=1250
